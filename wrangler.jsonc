{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nyc-schools-ratings",
  "main": "./server/index-worker.ts",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "nycschoolsratings.com/*",
      "zone_name": "nycschoolsratings.com"
    },
    {
      "pattern": "www.nycschoolsratings.com/*",
      "zone_name": "nycschoolsratings.com"
    }
  ],
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "def7c546eb804bbfb9e546d005c2266c",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:5432/nycschools"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["hello@nycschoolsratings.com"],
      "remote": true
    }
  ],
  "vars": {
    "APP_URL": "https://nycschoolsratings.com",
    "ENVIRONMENT": "production",
    "NODE_ENV": "production",
    "ADMIN_EMAILS": "biserd@gmail.com",
    "STRIPE_SEASON_PASS_PRODUCT_ID": "prod_Tc0wGwu3FOifBE",
    "STRIPE_SEASON_PASS_PRICE_ID": "price_1SemubRwvWaTf8xfAYvh2qJl",
    "EMAIL_FROM": "hello@nycschoolsratings.com",
    "EMAIL_FROM_NAME": "NYC School Ratings",
    "EMAIL_DELIVERY_ENABLED": "true"
  },
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "0 14 * * *",
      "0 9 1 * *"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nyc-schools-ratings",
  "main": "./server/index-worker.ts",
  "account_id": "73d71a2bef58f7469ecb48e2b8e84c0e",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "nycschoolsratings.com/*",
      "zone_name": "nycschoolsratings.com"
    },
    {
      "pattern": "www.nycschoolsratings.com/*",
      "zone_name": "nycschoolsratings.com"
    }
  ],
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [{"name":"PARENT_ASSISTANT_AGENT","class_name":"ParentAssistantAgent"}]
  },
  "exports": {
    "ParentAssistantAgent": {"type":"durable-object","storage":"sqlite"}
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nyc-schools-ratings-production",
      "database_id": "35237f81-df27-4908-be1a-1226faf501e0",
      "migrations_dir": "migrations-d1"
    }
  ],
  "queues": {
    "producers": [
      {"binding":"SAFETY_QUEUE","queue":"nyc-schools-production-safety"},
      {"binding":"PARENT_AGENT_QUEUE","queue":"nyc-schools-production-parent-agent"}
    ],
    "consumers": [
      {"queue":"nyc-schools-production-safety","max_batch_size":1,"max_concurrency":1,"max_retries":3,"retry_delay":60,"dead_letter_queue":"nyc-schools-production-safety-failed"},
      {"queue":"nyc-schools-production-parent-agent","max_batch_size":1,"max_batch_timeout":1,"max_concurrency":10,"max_retries":3,"retry_delay":10,"dead_letter_queue":"nyc-schools-production-parent-agent-failed"}
    ]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["hello@nycschoolsratings.com"],
      "remote": true
    }
  ],
  "vars": {
    "APP_URL": "https://nycschoolsratings.com",
    "ENVIRONMENT": "production",
    "PARENT_WHATSAPP_ENABLED": "true",
    "PARENT_ASSISTANT_ENABLED": "true",
    "PARENT_AGENT_SDK_ENABLED": "true",
    "PARENT_REMINDERS_ENABLED": "true",
    "FAMILY_CHECKOUT_ENABLED": "true",
    "PARENT_LAUNCH_VERIFIED": "true",
    "PARENT_REMINDER_CONTENT_SID": "HXcb3d96c071bada2d611b06b8498796e8",
    "PARENT_AGENT_QUEUE_NAME": "nyc-schools-production-parent-agent",
    "TWILIO_WHATSAPP_FROM": "whatsapp:+19174730386",
    "MAINTENANCE_MODE": "false",
    "NODE_ENV": "production",
    "ADMIN_EMAILS": "biserd@gmail.com",
    "STRIPE_SEASON_PASS_PRODUCT_ID": "prod_Tc0wGwu3FOifBE",
    "STRIPE_SEASON_PASS_PRICE_ID": "price_1SemubRwvWaTf8xfAYvh2qJl",
    "STRIPE_FAMILY_PREMIUM_PRICE_ID": "price_1UHTbBRwvWaTf8xfau7pgSYS",
    "EMAIL_FROM": "hello@nycschoolsratings.com",
    "EMAIL_FROM_NAME": "NYC School Ratings",
    "EMAIL_DELIVERY_ENABLED": "true",
    "INDEXNOW_KEY": "a4c2f27e06d54a0fa8bd43b93fe6bc72"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "*/15 * * * *",
      "0 14 * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
